# =============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE - ERP LOJA DE ROUPAS
# Copie para .env (na raiz para Docker Compose e em backend/.env no dev local)
# =============================================================================

# Ambiente de execução: development | staging | production
NODE_ENV=development

# Modo da aplicação:
# - portfolio_sandbox: Habilita Loja Demo 1-Clique, criação de loja teste com 2 produtos e reset 24h (Ideal para o Portfólio)
# - commercial_production: Desativa acesso visitante/sandbox e reset 24h (Ideal para cliente comercial real)
APP_MODE=portfolio_sandbox

# Porta do servidor Node.js
PORT=4000

# Banco de Dados PostgreSQL
DB_NAME=erp_roupas_dev
DB_USER=erp_user
DB_PASSWORD=erp_dev_password_123
DATABASE_URL=postgresql://erp_user:erp_dev_password_123@localhost:5432/erp_roupas_dev

# Segurança JWT (Use strings aleatórias de pelo menos 32 caracteres em homologação/produção)
# Dica: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_key_change_me_in_vps_9f8a7b6c5d4e3f2a1b
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_me_in_vps_1a2b3c4d5e6f7a8b9c

# Origem permitida no CORS (separe por vírgula se houver mais de uma)
CORS_ORIGIN=http://localhost:5173,https://erp.rafaelrmattos.com

# Credenciais da sua Loja Oficial (Admin Master que NÃO sofre reset de 24h)
ADMIN_EMAIL=admin@rafaelrmattos.com
ADMIN_PASSWORD=TroqueEstaSenhaForte!2026

# API Key padrão para integração com o motor gráfico Unity 3D (Meta Quest)
UNITY_DEFAULT_API_KEY=unity_quest_dev_key_change_in_vps_889900

# Limites do Modo Portfólio / Sandbox (Proteção da VPS de 1GB RAM / 25GB Disco)
SANDBOX_TTL_HOURS=24
SANDBOX_MAX_PRODUCTS=15
MAX_UPLOAD_SIZE_KB=500

# Nome da rede Docker onde o container caddy_proxy já está rodando na sua VPS
CADDY_DOCKER_NETWORK=portfolioweb_app-net

